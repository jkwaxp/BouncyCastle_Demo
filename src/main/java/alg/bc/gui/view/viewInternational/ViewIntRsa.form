                <children>
                  <component id="out" class="javax.swing.JTextArea" binding="cipherOutputTextArea">
                    <constraints/>
                    <properties><lineWrap value="true"/><rows value="6"/></properties>
                  </component>
                </children>
              </scrollpane>
            </children>
