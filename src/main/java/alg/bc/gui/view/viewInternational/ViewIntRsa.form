              </scrollpane>
              <component id="ls2" class="javax.swing.JLabel">
                <constraints><grid row="1" column="0" row-span="1" col-span="1" vsize-policy="0" hsize-policy="0" anchor="9" fill="0" indent="0" use-parent-layout="false"/></constraints>
                <properties><text value="签名数据："/></properties>
              </component>
              <scrollpane id="ss2">
                <constraints>
                  <grid row="1" column="1" row-span="1" col-span="1" vsize-policy="7" hsize-policy="7" anchor="0" fill="3" indent="0" use-parent-layout="false">
                    <preferred-size width="400" height="110"/>
                  </grid>
                </constraints>
                <properties/>
                <border type="none"/>
                <children>
                  <component id="smsg" class="javax.swing.JTextArea" binding="signMsgTextArea">
