              <component id="ls1" class="javax.swing.JLabel">
                <constraints><grid row="0" column="0" row-span="1" col-span="1" vsize-policy="0" hsize-policy="0" anchor="9" fill="0" indent="0" use-parent-layout="false"/></constraints>
                <properties><text value="签名私钥："/></properties>
              </component>
              <scrollpane id="ss1">
