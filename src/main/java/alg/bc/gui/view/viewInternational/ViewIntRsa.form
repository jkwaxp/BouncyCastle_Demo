<?xml version="1.0" encoding="UTF-8"?>
<form xmlns="http://www.intellij.com/uidesigner/form/" version="1" bind-to-class="alg.bc.gui.view.viewInternational.ViewIntRsa">
  <grid id="27dc6" binding="rsaPanel" layout-manager="GridLayoutManager" row-count="1" column-count="1" same-size-horizontally="false" same-size-vertically="false" hgap="-1" vgap="-1">
    <margin top="0" left="0" bottom="0" right="0"/>
    <constraints>
      <xy x="20" y="20" width="720" height="520"/>
    </constraints>
    <properties/>
    <border type="none"/>
    <children>
      <tabbedpane id="rsaTabs" default-binding="true">
        <constraints>
          <grid row="0" column="0" row-span="1" col-span="1" vsize-policy="3" hsize-policy="3" anchor="0" fill="3" indent="0" use-parent-layout="false">
            <preferred-size width="200" height="200"/>
          </grid>
        </constraints>
        <properties/>
        <border type="none"/>
        <children>
          <grid id="kp" layout-manager="GridLayoutManager" row-count="4" column-count="4" same-size-horizontally="false" same-size-vertically="false" hgap="-1" vgap="-1">
            <margin top="0" left="0" bottom="0" right="0"/>
            <constraints>
              <tabbedpane title="密钥对"/>
            </constraints>
            <properties/>
            <border type="none"/>
            <children>
              <component id="l0" class="javax.swing.JLabel">
                <constraints>
                  <grid row="0" column="0" row-span="1" col-span="1" vsize-policy="0" hsize-policy="0" anchor="9" fill="0" indent="0" use-parent-layout="false"/>
                </constraints>
                <properties>
                  <text value="KeySize："/>
                </properties>
              </component>
              <component id="ks" class="javax.swing.JComboBox" binding="keySizeComboBox">
                <constraints>
                  <grid row="0" column="1" row-span="1" col-span="1" vsize-policy="0" hsize-policy="3" anchor="8" fill="1" indent="0" use-parent-layout="false"/>
                </constraints>
                <properties/>
              </component>
              <component id="enc" class="javax.swing.JComboBox" binding="keyEncodeComboBox">
                <constraints>
                  <grid row="0" column="2" row-span="1" col-span="1" vsize-policy="0" hsize-policy="3" anchor="8" fill="1" indent="0" use-parent-layout="false"/>
                </constraints>
                <properties/>
              </component>
              <component id="gen" class="javax.swing.JButton" binding="generateKeyPairButton">
                <constraints>
                  <grid row="0" column="3" row-span="1" col-span="1" vsize-policy="0" hsize-policy="3" anchor="0" fill="0" indent="0" use-parent-layout="false"/>
                </constraints>
                <properties>
                  <text value="生成密钥对"/>
                </properties>
              </component>
              <component id="lp" class="javax.swing.JLabel">
                <constraints>
                  <grid row="1" column="0" row-span="1" col-span="1" vsize-policy="0" hsize-policy="0" anchor="9" fill="0" indent="0" use-parent-layout="false"/>
                </constraints>
                <properties>
                  <text value="公钥(X.509)："/>
                </properties>
              </component>
              <scrollpane id="sp1">
                <constraints>
                  <grid row="1" column="1" row-span="1" col-span="3" vsize-policy="7" hsize-policy="7" anchor="0" fill="3" indent="0" use-parent-layout="false">
                    <preferred-size width="500" height="110"/>
                  </grid>
                </constraints>
                <properties/>
                <border type="none"/>
                <children>
                  <component id="pub" class="javax.swing.JTextArea" binding="pubKeyTextArea">
                    <constraints/>
                    <properties>
                      <lineWrap value="true"/>
                      <rows value="6"/>
                    </properties>
                  </component>
                </children>
              </scrollpane>
              <component id="ls" class="javax.swing.JLabel">
                <constraints>
                  <grid row="2" column="0" row-span="1" col-span="1" vsize-policy="0" hsize-policy="0" anchor="9" fill="0" indent="0" use-parent-layout="false"/>
                </constraints>
                <properties>
                  <text value="私钥(PKCS#8)："/>
                </properties>
              </component>
              <scrollpane id="sp2">
                <constraints>
                  <grid row="2" column="1" row-span="1" col-span="3" vsize-policy="7" hsize-policy="7" anchor="0" fill="3" indent="0" use-parent-layout="false">
                    <preferred-size width="500" height="110"/>
                  </grid>
                </constraints>
                <properties/>
                <border type="none"/>
                <children>
                  <component id="prv" class="javax.swing.JTextArea" binding="prvKeyTextArea">
                    <constraints/>
                    <properties>
                      <lineWrap value="true"/>
                      <rows value="6"/>
                    </properties>
                  </component>
                </children>
              </scrollpane>
            </children>
          </grid>

          <!-- 加解密 -->
          <grid id="cipher" layout-manager="GridLayoutManager" row-count="6" column-count="4" same-size-horizontally="false" same-size-vertically="false" hgap="-1" vgap="-1">
            <margin top="0" left="0" bottom="0" right="0"/>
            <constraints>
              <tabbedpane title="加解密"/>
            </constraints>
            <properties/>
            <border type="none"/>
            <children>
              <component id="k1" class="javax.swing.JLabel">
                <constraints>
                  <grid row="0" column="0" row-span="1" col-span="1" vsize-policy="0" hsize-policy="0" anchor="9" fill="0" indent="0" use-parent-layout="false"/>
                </constraints>
                <properties>
                  <text value="加密密钥："/>
                </properties>
              </component>
              <scrollpane id="sck1">
                <constraints>
                  <grid row="0" column="1" row-span="1" col-span="2" vsize-policy="7" hsize-policy="7" anchor="0" fill="3" indent="0" use-parent-layout="false">
                    <preferred-size width="500" height="70"/>
                  </grid>
                </constraints>
