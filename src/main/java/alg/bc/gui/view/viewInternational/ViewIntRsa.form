                    </properties>
                  </component>
                </children>
              </scrollpane>
              <component id="dkt" class="javax.swing.JComboBox" binding="decryptKeyTypeComboBox">
                <constraints>
                  <grid row="1" column="3" row-span="1" col-span="1" vsize-policy="0" hsize-policy="3" anchor="8" fill="1" indent="0" use-parent-layout="false"/>
                </constraints>
                <properties/>
              </component>

              <component id="din" class="javax.swing.JLabel">
                <constraints>
                  <grid row="2" column="0" row-span="1" col-span="1" vsize-policy="0" hsize-policy="0" anchor="9" fill="0" indent="0" use-parent-layout="false"/>
                </constraints>
                <properties>
                  <text value="输入："/>
                </properties>
              </component>
              <scrollpane id="sin">
                <constraints>
                  <grid row="2" column="1" row-span="1" col-span="2" vsize-policy="7" hsize-policy="7" anchor="0" fill="3" indent="0" use-parent-layout="false">
                    <preferred-size width="500" height="110"/>
                  </grid>
                </constraints>
                <properties/>
                <border type="none"/>
                <children>
                  <component id="in" class="javax.swing.JTextArea" binding="cipherInputTextArea">
                    <constraints/>
                    <properties>
                      <lineWrap value="true"/>
                      <rows value="6"/>
                    </properties>
                  </component>
                </children>
              </scrollpane>
              <component id="inEnc" class="javax.swing.JComboBox" binding="cipherInputEncodeComboBox">
                <constraints>
                  <grid row="2" column="3" row-span="1" col-span="1" vsize-policy="0" hsize-policy="3" anchor="8" fill="1" indent="0" use-parent-layout="false"/>
                </constraints>
                <properties/>
              </component>

              <component id="eb" class="javax.swing.JButton" binding="rsaEncryptButton">
                <constraints>
                  <grid row="3" column="1" row-span="1" col-span="1" vsize-policy="0" hsize-policy="3" anchor="0" fill="0" indent="0" use-parent-layout="false"/>
                </constraints>
                <properties><text value="加密"/></properties>
              </component>
              <component id="db" class="javax.swing.JButton" binding="rsaDecryptButton">
                <constraints>
                  <grid row="3" column="2" row-span="1" col-span="1" vsize-policy="0" hsize-policy="3" anchor="0" fill="0" indent="0" use-parent-layout="false"/>
                </constraints>
                <properties><text value="解密"/></properties>
              </component>
              <component id="outEnc" class="javax.swing.JComboBox" binding="cipherOutputEncodeComboBox">
                <constraints>
                  <grid row="3" column="3" row-span="1" col-span="1" vsize-policy="0" hsize-policy="3" anchor="8" fill="1" indent="0" use-parent-layout="false"/>
                </constraints>
                <properties/>
