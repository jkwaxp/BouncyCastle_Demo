<?xml version="1.0" encoding="UTF-8"?>
<form xmlns="http://www.intellij.com/uidesigner/form/" version="1" bind-to-class="alg.bc.gui.view.viewSm9.ViewSm9Sign">
  <grid id="27dc6" binding="panel" layout-manager="GridLayoutManager" row-count="7" column-count="4" same-size-horizontally="false" same-size-vertically="false" hgap="-1" vgap="-1">
    <margin top="0" left="0" bottom="0" right="0"/>
    <constraints>
      <xy x="20" y="20" width="500" height="400"/>
    </constraints>
    <properties/>
    <border type="none"/>
    <children>
      <component id="e1" class="javax.swing.JLabel">
        <constraints>
          <grid row="0" column="0" row-span="1" col-span="1" vsize-policy="0" hsize-policy="0" anchor="8" fill="0" indent="0" use-parent-layout="false"/>
        </constraints>
        <properties>
          <text value="签名者ID："/>
        </properties>
      </component>
      <component id="e2" class="javax.swing.JTextField" binding="signUserIdTextField">
        <constraints>
          <grid row="0" column="1" row-span="1" col-span="3" vsize-policy="0" hsize-policy="6" anchor="8" fill="1" indent="0" use-parent-layout="false">
             <preferred-size width="150" height="-1"/>
          </grid>
        </constraints>
        <properties>
          <text value="signer@example.com"/>
        </properties>
      </component>
      
      <component id="e3" class="javax.swing.JLabel">
        <constraints>
          <grid row="1" column="0" row-span="1" col-span="1" vsize-policy="0" hsize-policy="0" anchor="8" fill="0" indent="0" use-parent-layout="false"/>
        </constraints>
        <properties>
          <text value="用户私钥(sk)："/>
        </properties>
      </component>
      <scrollpane id="sp1">
        <constraints>
          <grid row="1" column="1" row-span="1" col-span="3" vsize-policy="7" hsize-policy="7" anchor="0" fill="3" indent="0" use-parent-layout="false"/>
        </constraints>
        <properties/>
        <border type="none"/>
        <children>
          <component id="t1" class="javax.swing.JTextArea" binding="signSkSignTextArea">
            <constraints/>
            <properties>
              <rows value="4"/>
              <lineWrap value="true"/>
            </properties>
          </component>
        </children>
      </scrollpane>

      <component id="e4" class="javax.swing.JLabel">
        <constraints>
          <grid row="2" column="0" row-span="1" col-span="1" vsize-policy="0" hsize-policy="0" anchor="8" fill="0" indent="0" use-parent-layout="false"/>
        </constraints>
        <properties>
          <text value="签名主公钥(mpk)："/>
        </properties>
      </component>
      <scrollpane id="sp2">
        <constraints>
          <grid row="2" column="1" row-span="1" col-span="3" vsize-policy="7" hsize-policy="7" anchor="0" fill="3" indent="0" use-parent-layout="false"/>
        </constraints>
        <properties/>
        <border type="none"/>
        <children>
          <component id="t2" class="javax.swing.JTextArea" binding="verifyMpkSignTextArea">
            <constraints/>
            <properties>
              <rows value="4"/>
              <lineWrap value="true"/>
            </properties>
          </component>
        </children>
      </scrollpane>

      <component id="e5" class="javax.swing.JLabel">
        <constraints>
          <grid row="3" column="0" row-span="1" col-span="1" vsize-policy="0" hsize-policy="0" anchor="8" fill="0" indent="0" use-parent-layout="false"/>
        </constraints>
        <properties>
          <text value="消息："/>
        </properties>
      </component>
      <scrollpane id="sp3">
        <constraints>
          <grid row="3" column="1" row-span="1" col-span="2" vsize-policy="7" hsize-policy="7" anchor="0" fill="3" indent="0" use-parent-layout="false"/>
        </constraints>
        <properties/>
        <border type="none"/>
        <children>
          <component id="t3" class="javax.swing.JTextArea" binding="msgTextArea">
            <constraints/>
            <properties>
              <rows value="6"/>
              <lineWrap value="true"/>
            </properties>
          </component>
        </children>
      </scrollpane>
      <component id="c1" class="javax.swing.JComboBox" binding="msgEncodeComboBox">
        <constraints>
          <grid row="3" column="3" row-span="1" col-span="1" vsize-policy="0" hsize-policy="2" anchor="8" fill="1" indent="0" use-parent-layout="false"/>
        </constraints>
        <properties>
           <model>
            <item value="UTF-8"/>
            <item value="HEX"/>
            <item value="BASE64"/>
          </model>
        </properties>
      </component>

      <grid id="btns" layout-manager="FlowLayout" hgap="12" vgap="0" flow-align="1">
        <constraints>
          <grid row="4" column="0" row-span="1" col-span="4" vsize-policy="3" hsize-policy="3" anchor="0" fill="3" indent="0" use-parent-layout="false"/>
        </constraints>
        <properties/>
        <border type="none"/>
        <children>
          <component id="b1" class="javax.swing.JButton" binding="signButton">
            <constraints/>
            <properties>
              <text value="签名"/>
            </properties>
          </component>
          <component id="b2" class="javax.swing.JButton" binding="verifyButton">
            <constraints/>
            <properties>
              <text value="验签"/>
            </properties>
          </component>
        </children>
      </grid>

      <component id="e6" class="javax.swing.JLabel">
        <constraints>
          <grid row="5" column="0" row-span="1" col-span="1" vsize-policy="0" hsize-policy="0" anchor="8" fill="0" indent="0" use-parent-layout="false"/>
        </constraints>
        <properties>
          <text value="签名值："/>
        </properties>
      </component>
      <scrollpane id="sp4">
        <constraints>
          <grid row="5" column="1" row-span="1" col-span="2" vsize-policy="7" hsize-policy="7" anchor="0" fill="3" indent="0" use-parent-layout="false"/>
        </constraints>
        <properties/>
        <border type="none"/>
        <children>
          <component id="t4" class="javax.swing.JTextArea" binding="sigTextArea">
            <constraints/>
            <properties>
              <rows value="5"/>
              <lineWrap value="true"/>
            </properties>
          </component>
        </children>
      </scrollpane>
      <component id="c2" class="javax.swing.JComboBox" binding="sigEncodeComboBox">
        <constraints>
          <grid row="5" column="3" row-span="1" col-span="1" vsize-policy="0" hsize-policy="2" anchor="8" fill="1" indent="0" use-parent-layout="false"/>
        </constraints>
        <properties>
           <model>
            <item value="HEX"/>
            <item value="BASE64"/>
          </model>
        </properties>
      </component>
      
      <vspacer id="vsp">
        <constraints>
          <grid row="6" column="0" row-span="1" col-span="1" vsize-policy="6" hsize-policy="1" anchor="0" fill="2" indent="0" use-parent-layout="false"/>
        </constraints>
      </vspacer>
    </children>
  </grid>
</form>
