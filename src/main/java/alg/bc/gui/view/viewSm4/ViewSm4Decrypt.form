<?xml version="1.0" encoding="UTF-8"?>
<form xmlns="http://www.intellij.com/uidesigner/form/" version="1" bind-to-class="alg.bc.gui.view.viewSm4.ViewSm4Decrypt">
  <grid id="27dc6" binding="sm4DecryptPanel" layout-manager="GridLayoutManager" row-count="7" column-count="4" same-size-horizontally="false" same-size-vertically="false" hgap="-1" vgap="-1">
    <margin top="0" left="0" bottom="0" right="0"/>
    <constraints>
      <xy x="20" y="20" width="600" height="500"/>
    </constraints>
    <properties/>
    <border type="none"/>
    <children>
      <!-- 密钥行 -->
      <component id="a1" class="javax.swing.JLabel">
        <constraints>
          <grid row="0" column="0" row-span="1" col-span="1" vsize-policy="0" hsize-policy="0" anchor="8" fill="0" indent="0" use-parent-layout="false"/>
        </constraints>
        <properties>
          <text value="密钥："/>
        </properties>
      </component>
      <component id="a2" class="javax.swing.JTextArea" binding="keyTextArea">
        <constraints>
          <grid row="0" column="1" row-span="1" col-span="2" vsize-policy="6" hsize-policy="0" anchor="0" fill="3" indent="0" use-parent-layout="false">
            <preferred-size width="400" height="50"/>
          </grid>
        </constraints>
        <properties>
          <lineWrap value="true"/>
        </properties>
      </component>
      <component id="a3" class="javax.swing.JComboBox" binding="keyEncodeComboBox">
        <constraints>
          <grid row="0" column="3" row-span="1" col-span="1" vsize-policy="0" hsize-policy="2" anchor="8" fill="1" indent="0" use-parent-layout="false"/>
        </constraints>
        <properties>
          <model>
            <item value="HEX"/>
            <item value="BASE64"/>
          </model>
        </properties>
      </component>

      <!-- 密文行 -->
      <component id="b1" class="javax.swing.JLabel">
        <constraints>
          <grid row="1" column="0" row-span="1" col-span="1" vsize-policy="0" hsize-policy="0" anchor="8" fill="0" indent="0" use-parent-layout="false"/>
        </constraints>
        <properties>
          <text value="密文："/>
        </properties>
      </component>
      <component id="b2" class="javax.swing.JTextArea" binding="cipherTextArea">
        <constraints>
          <grid row="1" column="1" row-span="1" col-span="2" vsize-policy="6" hsize-policy="0" anchor="0" fill="3" indent="0" use-parent-layout="false">
            <preferred-size width="400" height="50"/>
          </grid>
        </constraints>
        <properties>
          <lineWrap value="true"/>
        </properties>
      </component>
      <component id="b3" class="javax.swing.JComboBox" binding="cipherEncodeComboBox">
        <constraints>
          <grid row="1" column="3" row-span="1" col-span="1" vsize-policy="0" hsize-policy="2" anchor="8" fill="1" indent="0" use-parent-layout="false"/>
        </constraints>
        <properties>
          <model>
            <item value="HEX"/>
            <item value="BASE64"/>
          </model>
        </properties>
      </component>

      <!-- 模式 -->
      <component id="c1" class="javax.swing.JLabel">
        <constraints>
          <grid row="2" column="0" row-span="1" col-span="1" vsize-policy="0" hsize-policy="0" anchor="8" fill="0" indent="0" use-parent-layout="false"/>
        </constraints>
        <properties>
          <text value="模式："/>
        </properties>
      </component>
      <component id="c2" class="javax.swing.JComboBox" binding="modeComboBox">
        <constraints>
          <grid row="2" column="1" row-span="1" col-span="1" vsize-policy="0" hsize-policy="2" anchor="8" fill="1" indent="0" use-parent-layout="false"/>
        </constraints>
        <properties>
          <model>
            <item value="ECB"/>
            <item value="CBC"/>
            <item value="CFB"/>
            <item value="OFB"/>
            <item value="GCM"/>
          </model>
        </properties>
      </component>

      <!-- 填充 -->
      <component id="c3" class="javax.swing.JLabel">
        <constraints>
          <grid row="2" column="2" row-span="1" col-span="1" vsize-policy="0" hsize-policy="0" anchor="8" fill="0" indent="0" use-parent-layout="false"/>
        </constraints>
        <properties>
          <text value="填充："/>
        </properties>
      </component>
      <component id="c4" class="javax.swing.JComboBox" binding="paddingComboBox">
        <constraints>
          <grid row="2" column="3" row-span="1" col-span="1" vsize-policy="0" hsize-policy="2" anchor="8" fill="1" indent="0" use-parent-layout="false"/>
        </constraints>
        <properties>
          <model>
            <item value="PKCS7"/>
            <item value="NoPadding"/>
          </model>
        </properties>
      </component>

      <!-- IV行 -->
      <component id="d1" class="javax.swing.JLabel" binding="ivLabel">
        <constraints>
          <grid row="3" column="0" row-span="1" col-span="1" vsize-policy="0" hsize-policy="0" anchor="8" fill="0" indent="0" use-parent-layout="false"/>
        </constraints>
        <properties>
          <text value="IV："/>
        </properties>
      </component>
      <component id="d2" class="javax.swing.JTextArea" binding="ivTextArea">
        <constraints>
          <grid row="3" column="1" row-span="1" col-span="2" vsize-policy="6" hsize-policy="0" anchor="0" fill="3" indent="0" use-parent-layout="false">
            <preferred-size width="400" height="50"/>
          </grid>
        </constraints>
        <properties>
          <lineWrap value="true"/>
        </properties>
      </component>
      <component id="d3" class="javax.swing.JComboBox" binding="ivEncodeComboBox">
        <constraints>
          <grid row="3" column="3" row-span="1" col-span="1" vsize-policy="0" hsize-policy="2" anchor="8" fill="1" indent="0" use-parent-layout="false"/>
        </constraints>
        <properties>
          <model>
            <item value="HEX"/>
            <item value="BASE64"/>
          </model>
        </properties>
      </component>

      <!-- 明文行 -->
      <component id="e1" class="javax.swing.JLabel">
        <constraints>
          <grid row="4" column="0" row-span="1" col-span="1" vsize-policy="0" hsize-policy="0" anchor="8" fill="0" indent="0" use-parent-layout="false"/>
        </constraints>
        <properties>
          <text value="明文："/>
        </properties>
      </component>
      <component id="e2" class="javax.swing.JTextArea" binding="dataTextArea">
        <constraints>
          <grid row="4" column="1" row-span="1" col-span="2" vsize-policy="6" hsize-policy="0" anchor="0" fill="3" indent="0" use-parent-layout="false">
            <preferred-size width="400" height="50"/>
          </grid>
        </constraints>
        <properties>
          <lineWrap value="true"/>
        </properties>
      </component>
      <component id="e3" class="javax.swing.JComboBox" binding="dataEncodeComboBox">
        <constraints>
          <grid row="4" column="3" row-span="1" col-span="1" vsize-policy="0" hsize-policy="2" anchor="8" fill="1" indent="0" use-parent-layout="false"/>
        </constraints>
        <properties>
          <model>
            <item value="UTF-8"/>
            <item value="HEX"/>
            <item value="BASE64"/>
          </model>
        </properties>
      </component>

      <!-- 按钮行 (row 6, skipping row 5) -->
      <component id="f1" class="javax.swing.JButton" binding="decryptButton">
        <constraints>
          <grid row="6" column="1" row-span="1" col-span="1" vsize-policy="0" hsize-policy="3" anchor="0" fill="0" indent="0" use-parent-layout="false"/>
        </constraints>
        <properties>
          <text value="解密"/>
        </properties>
      </component>
      <component id="f2" class="javax.swing.JButton" binding="resetButton">
        <constraints>
          <grid row="6" column="2" row-span="1" col-span="1" vsize-policy="0" hsize-policy="3" anchor="0" fill="0" indent="0" use-parent-layout="false"/>
        </constraints>
        <properties>
          <text value="重置"/>
        </properties>
      </component>
    </children>
  </grid>
</form>
