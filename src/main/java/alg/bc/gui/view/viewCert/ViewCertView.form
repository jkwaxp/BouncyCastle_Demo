<?xml version="1.0" encoding="UTF-8"?>
<form xmlns="http://www.intellij.com/uidesigner/form/" version="1" bind-to-class="alg.bc.gui.view.viewCert.ViewCertView">
  <grid id="27dc6" binding="certViewPanel" layout-manager="GridLayoutManager" row-count="8" column-count="3" same-size-horizontally="false" same-size-vertically="false" hgap="-1" vgap="-1">
    <margin top="10" left="10" bottom="10" right="10"/>
    <constraints>
      <xy x="20" y="20" width="700" height="600"/>
    </constraints>
    <properties/>
    <border type="none"/>
    <children>
      <!-- 证书输入 -->
      <component id="c1" class="javax.swing.JLabel">
        <constraints>
          <grid row="0" column="0" row-span="1" col-span="1" vsize-policy="0" hsize-policy="0" anchor="9" fill="0" indent="0" use-parent-layout="false"/>
        </constraints>
        <properties>
          <text value="证书内容(PEM)："/>
        </properties>
      </component>
      <scrollpane id="c2">
        <constraints>
          <grid row="0" column="1" row-span="1" col-span="2" vsize-policy="7" hsize-policy="7" anchor="0" fill="3" indent="0" use-parent-layout="false">
            <preferred-size width="500" height="150"/>
          </grid>
        </constraints>
        <properties/>
        <border type="none"/>
        <children>
          <component id="c3" class="javax.swing.JTextArea" binding="certInputTextArea">
            <constraints/>
            <properties>
              <lineWrap value="true"/>
              <rows value="8"/>
            </properties>
          </component>
        </children>
      </scrollpane>

      <!-- 空行 -->
      <vspacer id="sp1">
        <constraints>
          <grid row="1" column="0" row-span="1" col-span="3" vsize-policy="0" hsize-policy="1" anchor="0" fill="2" indent="0" use-parent-layout="false">
            <preferred-size width="-1" height="10"/>
          </grid>
        </constraints>
      </vspacer>

      <!-- 按钮行 -->
      <component id="b1" class="javax.swing.JButton" binding="parseButton">
        <constraints>
          <grid row="2" column="0" row-span="1" col-span="1" vsize-policy="0" hsize-policy="3" anchor="0" fill="1" indent="0" use-parent-layout="false"/>
        </constraints>
        <properties>
          <text value="解析证书"/>
        </properties>
      </component>
      <component id="b2" class="javax.swing.JButton" binding="loadFileButton">
        <constraints>
          <grid row="2" column="1" row-span="1" col-span="1" vsize-policy="0" hsize-policy="3" anchor="0" fill="1" indent="0" use-parent-layout="false"/>
        </constraints>
        <properties>
          <text value="加载文件"/>
        </properties>
      </component>
      <component id="b3" class="javax.swing.JButton" binding="resetButton">
        <constraints>
          <grid row="2" column="2" row-span="1" col-span="1" vsize-policy="0" hsize-policy="3" anchor="0" fill="1" indent="0" use-parent-layout="false"/>
        </constraints>
        <properties>
          <text value="重置"/>
        </properties>
      </component>

      <!-- 工具箱按钮行（P0/P1） -->
      <grid id="toolPanel" binding="toolPanel" layout-manager="GridLayoutManager" row-count="2" column-count="6" same-size-horizontally="false" same-size-vertically="false" hgap="-1" vgap="-1">
        <margin top="0" left="0" bottom="0" right="0"/>
        <constraints>
          <grid row="3" column="0" row-span="1" col-span="3" vsize-policy="0" hsize-policy="3" anchor="8" fill="1" indent="0" use-parent-layout="false"/>
        </constraints>
        <properties/>
        <border type="none"/>
        <children>
          <component id="tb1" class="javax.swing.JButton" binding="toPemButton">
            <constraints>
              <grid row="0" column="0" row-span="1" col-span="1" vsize-policy="0" hsize-policy="0" anchor="8" fill="0" indent="0" use-parent-layout="false"/>
            </constraints>
            <properties>
              <text value="转换为PEM"/>
            </properties>
          </component>
          <component id="tb2" class="javax.swing.JButton" binding="toDerBase64Button">
            <constraints>
              <grid row="0" column="1" row-span="1" col-span="1" vsize-policy="0" hsize-policy="0" anchor="8" fill="0" indent="0" use-parent-layout="false"/>
            </constraints>
            <properties>
              <text value="DER(Base64)"/>
            </properties>
          </component>
          <component id="tb3" class="javax.swing.JButton" binding="toDerHexButton">
            <constraints>
              <grid row="0" column="2" row-span="1" col-span="1" vsize-policy="0" hsize-policy="0" anchor="8" fill="0" indent="0" use-parent-layout="false"/>
            </constraints>
            <properties>
              <text value="DER(HEX)"/>
            </properties>
          </component>
          <component id="tb4" class="javax.swing.JButton" binding="splitPemButton">
            <constraints>
              <grid row="0" column="3" row-span="1" col-span="1" vsize-policy="0" hsize-policy="0" anchor="8" fill="0" indent="0" use-parent-layout="false"/>
            </constraints>
            <properties>
              <text value="拆分PEM"/>
            </properties>
          </component>
          <component id="tbL1" class="javax.swing.JLabel">
            <constraints>
              <grid row="0" column="4" row-span="1" col-span="1" vsize-policy="0" hsize-policy="0" anchor="8" fill="0" indent="0" use-parent-layout="false"/>
            </constraints>
            <properties>
              <text value="P12口令："/>
            </properties>
          </component>
          <component id="tbPwd" class="javax.swing.JPasswordField" binding="p12PasswordField">
            <constraints>
              <grid row="0" column="5" row-span="1" col-span="1" vsize-policy="0" hsize-policy="6" anchor="8" fill="1" indent="0" use-parent-layout="false"/>
            </constraints>
            <properties>
              <columns value="10"/>
            </properties>
          </component>
          <component id="tb5" class="javax.swing.JButton" binding="verifyChainButton">
            <constraints>
              <grid row="1" column="0" row-span="1" col-span="1" vsize-policy="0" hsize-policy="0" anchor="8" fill="0" indent="0" use-parent-layout="false"/>
            </constraints>
            <properties>
              <text value="验证链"/>
            </properties>
          </component>
          <component id="tb6" class="javax.swing.JButton" binding="saveInfoButton">
            <constraints>
              <grid row="1" column="1" row-span="1" col-span="1" vsize-policy="0" hsize-policy="0" anchor="8" fill="0" indent="0" use-parent-layout="false"/>
            </constraints>
            <properties>
              <text value="保存输出"/>
            </properties>
          </component>
          <component id="tb7" class="javax.swing.JButton" binding="buildChainButton">
            <constraints>
              <grid row="1" column="2" row-span="1" col-span="1" vsize-policy="0" hsize-policy="0" anchor="8" fill="0" indent="0" use-parent-layout="false"/>
            </constraints>
            <properties>
              <text value="构建链"/>
            </properties>
          </component>
          <component id="tb8" class="javax.swing.JButton" binding="exportPemButton">
            <constraints>
              <grid row="1" column="3" row-span="1" col-span="1" vsize-policy="0" hsize-policy="0" anchor="8" fill="0" indent="0" use-parent-layout="false"/>
            </constraints>
            <properties>
              <text value="导出PEM"/>
            </properties>
          </component>
          <component id="tb9" class="javax.swing.JButton" binding="exportDerButton">
            <constraints>
              <grid row="1" column="4" row-span="1" col-span="1" vsize-policy="0" hsize-policy="0" anchor="8" fill="0" indent="0" use-parent-layout="false"/>
            </constraints>
            <properties>
              <text value="导出DER"/>
            </properties>
          </component>
          <hspacer id="toolHSpacer">
            <constraints>
              <grid row="1" column="5" row-span="1" col-span="1" vsize-policy="0" hsize-policy="6" anchor="0" fill="1" indent="0" use-parent-layout="false"/>
            </constraints>
          </hspacer>
        </children>
      </grid>

      <component id="trustLabel" class="javax.swing.JLabel">
        <constraints>
          <grid row="4" column="0" row-span="1" col-span="1" vsize-policy="0" hsize-policy="0" anchor="9" fill="0" indent="0" use-parent-layout="false"/>
        </constraints>
        <properties>
          <text value="信任根/中间证书(PEM，可多张)："/>
        </properties>
      </component>
      <scrollpane id="trustScroll">
        <constraints>
          <grid row="4" column="1" row-span="1" col-span="2" vsize-policy="7" hsize-policy="7" anchor="0" fill="3" indent="0" use-parent-layout="false">
            <preferred-size width="500" height="110"/>
          </grid>
        </constraints>
        <properties/>
        <border type="none"/>
        <children>
          <component id="trustArea" class="javax.swing.JTextArea" binding="trustPemTextArea">
            <constraints/>
            <properties>
              <lineWrap value="true"/>
              <rows value="5"/>
            </properties>
          </component>
        </children>
      </scrollpane>

      <!-- 空行 -->
      <vspacer id="sp2">
        <constraints>
          <grid row="5" column="0" row-span="1" col-span="3" vsize-policy="0" hsize-policy="1" anchor="0" fill="2" indent="0" use-parent-layout="false">
            <preferred-size width="-1" height="10"/>
          </grid>
        </constraints>
      </vspacer>

      <!-- 证书信息输出 -->
      <component id="i1" class="javax.swing.JLabel">
        <constraints>
          <grid row="6" column="0" row-span="1" col-span="1" vsize-policy="0" hsize-policy="0" anchor="9" fill="0" indent="0" use-parent-layout="false"/>
        </constraints>
        <properties>
          <text value="证书信息："/>
        </properties>
      </component>
      <scrollpane id="i2">
        <constraints>
          <grid row="6" column="1" row-span="1" col-span="2" vsize-policy="7" hsize-policy="7" anchor="0" fill="3" indent="0" use-parent-layout="false">
            <preferred-size width="500" height="250"/>
          </grid>
        </constraints>
        <properties/>
        <border type="none"/>
        <children>
          <component id="i3" class="javax.swing.JTextArea" binding="certInfoTextArea">
            <constraints/>
            <properties>
              <editable value="false"/>
              <lineWrap value="true"/>
              <rows value="12"/>
            </properties>
          </component>
        </children>
      </scrollpane>

      <!-- 填充空白区域 -->
      <vspacer id="sp3">
        <constraints>
          <grid row="7" column="0" row-span="1" col-span="3" vsize-policy="6" hsize-policy="1" anchor="0" fill="2" indent="0" use-parent-layout="false"/>
        </constraints>
      </vspacer>
    </children>
  </grid>
</form>
