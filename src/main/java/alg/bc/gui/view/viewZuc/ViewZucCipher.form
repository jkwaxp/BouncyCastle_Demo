<?xml version="1.0" encoding="UTF-8"?>
<form xmlns="http://www.intellij.com/uidesigner/form/" version="1" bind-to-class="alg.bc.gui.view.viewZuc.ViewZucCipher">
  <grid id="27dc6" binding="zucCipherPanel" layout-manager="GridLayoutManager" row-count="9" column-count="4" same-size-horizontally="false" same-size-vertically="false" hgap="-1" vgap="-1">
    <margin top="0" left="0" bottom="0" right="0"/>
    <constraints>
      <xy x="20" y="20" width="600" height="500"/>
    </constraints>
    <properties/>
    <border type="none"/>
    <children>
      <!-- ZUC版本选择 -->
      <component id="v1" class="javax.swing.JLabel">
        <constraints>
          <grid row="0" column="0" row-span="1" col-span="1" vsize-policy="0" hsize-policy="0" anchor="8" fill="0" indent="0" use-parent-layout="false"/>
        </constraints>
        <properties>
          <text value="ZUC版本："/>
        </properties>
      </component>
      <component id="v2" class="javax.swing.JRadioButton" binding="zuc128RadioButton">
        <constraints>
          <grid row="0" column="1" row-span="1" col-span="1" vsize-policy="0" hsize-policy="3" anchor="8" fill="0" indent="0" use-parent-layout="false"/>
        </constraints>
        <properties>
          <selected value="true"/>
          <text value="ZUC-128"/>
        </properties>
      </component>
      <component id="v3" class="javax.swing.JRadioButton" binding="zuc256RadioButton">
        <constraints>
          <grid row="0" column="2" row-span="1" col-span="2" vsize-policy="0" hsize-policy="3" anchor="8" fill="0" indent="0" use-parent-layout="false"/>
        </constraints>
        <properties>
          <text value="ZUC-256"/>
        </properties>
      </component>

      <!-- 密钥行 -->
      <component id="k1" class="javax.swing.JLabel" binding="keySizeLabel">
        <constraints>
          <grid row="1" column="0" row-span="1" col-span="1" vsize-policy="0" hsize-policy="0" anchor="8" fill="0" indent="0" use-parent-layout="false"/>
        </constraints>
        <properties>
          <text value="密钥(16字节)："/>
        </properties>
      </component>
      <component id="k2" class="javax.swing.JTextArea" binding="keyTextArea">
        <constraints>
          <grid row="1" column="1" row-span="1" col-span="2" vsize-policy="6" hsize-policy="0" anchor="0" fill="3" indent="0" use-parent-layout="false">
            <preferred-size width="400" height="50"/>
          </grid>
        </constraints>
        <properties>
          <lineWrap value="true"/>
        </properties>
      </component>
      <component id="k3" class="javax.swing.JComboBox" binding="keyEncodeComboBox">
        <constraints>
          <grid row="1" column="3" row-span="1" col-span="1" vsize-policy="0" hsize-policy="2" anchor="8" fill="1" indent="0" use-parent-layout="false"/>
        </constraints>
        <properties>
          <model>
            <item value="HEX"/>
            <item value="BASE64"/>
          </model>
        </properties>
      </component>

      <!-- 生成密钥按钮 -->
      <component id="k4" class="javax.swing.JButton" binding="generateKeyButton">
        <constraints>
          <grid row="2" column="1" row-span="1" col-span="1" vsize-policy="0" hsize-policy="3" anchor="0" fill="0" indent="0" use-parent-layout="false"/>
        </constraints>
        <properties>
          <text value="生成密钥"/>
        </properties>
      </component>

      <!-- IV行 -->
      <component id="i1" class="javax.swing.JLabel" binding="ivSizeLabel">
        <constraints>
          <grid row="3" column="0" row-span="1" col-span="1" vsize-policy="0" hsize-policy="0" anchor="8" fill="0" indent="0" use-parent-layout="false"/>
        </constraints>
        <properties>
          <text value="IV(16字节)："/>
        </properties>
      </component>
      <component id="i2" class="javax.swing.JTextArea" binding="ivTextArea">
        <constraints>
          <grid row="3" column="1" row-span="1" col-span="2" vsize-policy="6" hsize-policy="0" anchor="0" fill="3" indent="0" use-parent-layout="false">
            <preferred-size width="400" height="50"/>
          </grid>
        </constraints>
        <properties>
          <lineWrap value="true"/>
        </properties>
      </component>
      <component id="i3" class="javax.swing.JComboBox" binding="ivEncodeComboBox">
        <constraints>
          <grid row="3" column="3" row-span="1" col-span="1" vsize-policy="0" hsize-policy="2" anchor="8" fill="1" indent="0" use-parent-layout="false"/>
        </constraints>
        <properties>
          <model>
            <item value="HEX"/>
            <item value="BASE64"/>
          </model>
        </properties>
      </component>

      <!-- 生成IV按钮 -->
      <component id="i4" class="javax.swing.JButton" binding="generateIvButton">
        <constraints>
          <grid row="4" column="1" row-span="1" col-span="1" vsize-policy="0" hsize-policy="3" anchor="0" fill="0" indent="0" use-parent-layout="false"/>
        </constraints>
        <properties>
          <text value="生成IV"/>
        </properties>
      </component>

      <!-- 输入数据行 -->
      <component id="d1" class="javax.swing.JLabel">
        <constraints>
          <grid row="5" column="0" row-span="1" col-span="1" vsize-policy="0" hsize-policy="0" anchor="8" fill="0" indent="0" use-parent-layout="false"/>
        </constraints>
        <properties>
          <text value="输入数据："/>
        </properties>
      </component>
      <component id="d2" class="javax.swing.JTextArea" binding="inputTextArea">
        <constraints>
          <grid row="5" column="1" row-span="1" col-span="2" vsize-policy="6" hsize-policy="0" anchor="0" fill="3" indent="0" use-parent-layout="false">
            <preferred-size width="400" height="50"/>
          </grid>
        </constraints>
        <properties>
          <lineWrap value="true"/>
        </properties>
      </component>
      <component id="d3" class="javax.swing.JComboBox" binding="inputEncodeComboBox">
        <constraints>
          <grid row="5" column="3" row-span="1" col-span="1" vsize-policy="0" hsize-policy="2" anchor="8" fill="1" indent="0" use-parent-layout="false"/>
        </constraints>
        <properties>
          <model>
            <item value="UTF-8"/>
            <item value="HEX"/>
            <item value="BASE64"/>
          </model>
        </properties>
      </component>

      <!-- 输出数据行 -->
      <component id="o1" class="javax.swing.JLabel">
        <constraints>
          <grid row="6" column="0" row-span="1" col-span="1" vsize-policy="0" hsize-policy="0" anchor="8" fill="0" indent="0" use-parent-layout="false"/>
        </constraints>
        <properties>
          <text value="输出数据："/>
        </properties>
      </component>
      <component id="o2" class="javax.swing.JTextArea" binding="outputTextArea">
        <constraints>
          <grid row="6" column="1" row-span="1" col-span="2" vsize-policy="6" hsize-policy="0" anchor="0" fill="3" indent="0" use-parent-layout="false">
            <preferred-size width="400" height="50"/>
          </grid>
        </constraints>
        <properties>
          <lineWrap value="true"/>
        </properties>
      </component>
      <component id="o3" class="javax.swing.JComboBox" binding="outputEncodeComboBox">
        <constraints>
          <grid row="6" column="3" row-span="1" col-span="1" vsize-policy="0" hsize-policy="2" anchor="8" fill="1" indent="0" use-parent-layout="false"/>
        </constraints>
        <properties>
          <model>
            <item value="HEX"/>
            <item value="BASE64"/>
            <item value="UTF-8"/>
          </model>
        </properties>
      </component>

      <!-- 按钮行 -->
      <component id="b1" class="javax.swing.JButton" binding="cipherButton">
        <constraints>
          <grid row="8" column="1" row-span="1" col-span="1" vsize-policy="0" hsize-policy="3" anchor="0" fill="0" indent="0" use-parent-layout="false"/>
        </constraints>
        <properties>
          <text value="加密/解密"/>
        </properties>
      </component>
      <component id="b2" class="javax.swing.JButton" binding="resetButton">
        <constraints>
          <grid row="8" column="2" row-span="1" col-span="1" vsize-policy="0" hsize-policy="3" anchor="0" fill="0" indent="0" use-parent-layout="false"/>
        </constraints>
        <properties>
          <text value="重置"/>
        </properties>
      </component>
    </children>
  </grid>
</form>
